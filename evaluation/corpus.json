    {"id": "removed-security-scanner", "class": "critical-mutation", "expected": "human-attention"},
    {"id": "weakened-assertion", "class": "critical-mutation", "expected": "human-attention"},
    {"id": "reduced-coverage-threshold", "class": "critical-mutation", "expected": "human-attention"},
    {"id": "ci-command-or-true", "class": "critical-mutation", "expected": "human-attention"},
    {"id": "unmapped-change-surface", "class": "out-of-scope-control", "expected": "deep-review-unknown-effort"},
    {"id": "duo-assessment-stale-head", "class": "stale-evidence-control", "expected": "no-link"},
    {"id": "duo-assessment-exact-head", "class": "exact-revision-control", "expected": "link-preserving-deterministic-package"}
